# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
SUPABASE_DB_URL=postgresql://postgres.your-ref:password@aws-0-us-west-2.pooler.supabase.com:6543/postgres

# Server
PORT=8787
BOOKING_ALLOWED_ORIGINS=http://localhost:3000
BOOKING_SESSION_HEADER=x-booking-session

# Seed controls
# SEED_DAYS=45
# SEED_BASE_DATE=2026-06-01

# Vercel Cron — when set, /v1/_cron/* requires Authorization: Bearer <secret>.
# Leave empty in local dev. Vercel auto-injects this on the platform.
# CRON_SECRET=

# Ops incident console (3am outage demo)
# Shared secret guarding /v1/_ops/*. When set, every ops request must send
# Authorization: Bearer <secret>. The booking-frontend /ops console and the
# nightly demo-reset workflow use the same value. Leave empty in local dev.
# OPS_SHARED_SECRET=
