# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
SUPABASE_DB_URL=postgresql://postgres.your-ref:password@aws-0-us-west-2.pooler.supabase.com:6543/postgres

# Server
PORT=8787
BOOKING_ALLOWED_ORIGINS=http://localhost:3000
BOOKING_SESSION_HEADER=x-booking-session

# Scoped (per-session) outage: the frontend forwards the demo presenter's
# session id in this header so the backend can break the site for that one
# session only. DEMO_SESSION_TTL_SECONDS is how long an armed scoped session
# stays active (default 1200 = 20 minutes).
DEMO_SESSION_HEADER=x-demo-session
# DEMO_SESSION_TTL_SECONDS=1200

# Seed controls
# SEED_DAYS=45
# SEED_BASE_DATE=2026-06-01

# Vercel Cron — when set, /v1/_cron/* requires Authorization: Bearer <secret>.
# Leave empty in local dev. Vercel auto-injects this on the platform.
# CRON_SECRET=

# Ops incident console (3am outage demo)
# Shared secret guarding /v1/_ops/*. When set, every ops request must send
# Authorization: Bearer <secret>. The booking-frontend /ops console and the
# nightly demo-reset workflow use the same value. Leave empty in local dev.
# OPS_SHARED_SECRET=

# FlyLo Ops Agent (airline disruption/recovery endpoints under /v1/ops)
# Bearer token identifying the external ops agent as a service principal. When
# set, every /v1/ops request must send Authorization: Bearer <OPS_AGENT_TOKEN>.
# When unset the /v1/ops endpoints are open in local dev but return 503 in
# production. Distinct from OPS_SHARED_SECRET (which guards the /v1/_ops
# incident console) and from the browser x-booking-session identity. Provide as
# a platform secret; never commit real values.
# OPS_AGENT_TOKEN=

# Jira Cloud (request_marketing_change MCP tool)
# All four are optional. When they are all set, the request_marketing_change
# MCP tool files a marketing-request ticket into Jira. When any is unset the
# tool degrades gracefully and reports that Jira is not configured, so local
# dev and the build work without credentials. Provide these as platform
# secrets; never commit real values.
# JIRA_BASE_URL=https://your-org.atlassian.net
# JIRA_EMAIL=you@your-org.example
# JIRA_API_TOKEN=
# JIRA_PROJECT_KEY=MKT
